# Nudge hub settings. Only root and the hub can read this file.
NUDGE_DATA=/var/lib/nudge
NUDGE_PORT=8787
NUDGE_SCREEN_DIR=/opt/nudge/screen
NUDGE_APPS_DIR=/opt/nudge/apps
NUDGE_CHROMIUM=/usr/bin/chromium
# Allow phones on the home Wi-Fi (not just Tailscale). 0 = Tailscale only.
NUDGE_ALLOW_LAN=1
# Assistants and connected apps. Set them with:  sudo nudge key openrouter|gemini|composio
# Text assistant (openrouter.ai/keys). Requests only go to zero-data-retention providers.
OPENROUTER_API_KEY=
# Voice assistant on the wall (Gemini Live; use a key from a billing-enabled project).
GEMINI_API_KEY=
# Connected apps (Composio).
COMPOSIO_API_KEY=
# Filled in by nudge-cert when Tailscale HTTPS is on:
#NUDGE_TLS_CERT=/var/lib/nudge/tls/cert.pem
#NUDGE_TLS_KEY=/var/lib/nudge/tls/key.pem
