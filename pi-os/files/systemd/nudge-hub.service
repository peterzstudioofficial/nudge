[Unit]
Description=Nudge hub (data, rules, school reader, assistant)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=nudge
Group=nudge
EnvironmentFile=/etc/nudge/hub.env
# A small heap is plenty for the hub and keeps garbage collection quick on a Pi.
ExecStart=/opt/nudge/node/bin/node --no-warnings=ExperimentalWarning --max-old-space-size=160 /opt/nudge/hub/hub.mjs
WorkingDirectory=/opt/nudge/hub
Environment=HOME=/var/lib/nudge
Restart=always
RestartSec=3
# The hub may listen on 443 for the Tailscale HTTPS name.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Lock it down: it can only write its own data folder.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=no
ReadWritePaths=/var/lib/nudge
ReadOnlyPaths=/etc/nudge
UMask=0077
MemoryHigh=420M

[Install]
WantedBy=multi-user.target
