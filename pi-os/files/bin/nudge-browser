#!/bin/sh
# Chromium tuned for a Pi 3 / 4 wall screen: one window, no UI, small memory footprint.
CHROME=$(command -v chromium || command -v chromium-browser)
exec "$CHROME" \
  --kiosk --app=http://127.0.0.1:8788/screen/ \
  --ozone-platform=wayland \
  --noerrdialogs --disable-infobars --no-first-run --no-default-browser-check \
  --disable-translate --disable-features=Translate,MediaRouter,OptimizationHints,InterestFeedContentSuggestions \
  --disable-background-networking --disable-sync --disable-component-update \
  --check-for-update-interval=31536000 \
  --password-store=basic --use-mock-keychain \
  --renderer-process-limit=2 --js-flags=--max-old-space-size=192 \
  --disk-cache-dir=/tmp/nudge-chromium-cache --disk-cache-size=33554432 \
  --overscroll-history-navigation=0 --disable-pinch \
  --autoplay-policy=no-user-gesture-required \
  --user-data-dir=/home/kiosk/.config/nudge-chromium
