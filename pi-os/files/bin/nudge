#!/bin/sh
# Nudge device helper. Run with sudo.
#   nudge status              what's running, addresses, disk + memory
#   nudge pair [owner|parent|desktop]
#                             print a one-time pairing code (10 minutes)
#   nudge key openrouter|gemini|composio   set an API key
#   nudge logs [hub|kiosk|gpio]
#   nudge restart             restart hub, screen and hardware daemon
#   nudge update FILE.tar.gz  install a newer nudge-pi bundle (keeps all data)
#   nudge backup [DIR]        copy the database + secrets to DIR (default: ~)
#   nudge import FILE.json    load a setup file (timetable, homework plan, birthdays, staff…)
#   nudge calendar FILE.pdf   read a term's school calendar PDF
#   nudge dev on [HOURS]      switch on the dev tools page (/dev) for a few hours (max 24)
#   nudge dev off             switch them off now (an update or reinstall also removes them)
set -e
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"

hub() {
  set -a; . /etc/nudge/hub.env; set +a
  cd /opt/nudge/hub
  exec runuser -u nudge -- /opt/nudge/node/bin/node --no-warnings=ExperimentalWarning hub.mjs "$@"
}

case "$1" in
  status)
    systemctl --no-pager --lines=0 status nudge-hub nudge-kiosk nudge-gpio | grep -E '●|Active:' || true
    echo; echo "addresses:"
    hostname -I | tr ' ' '\n' | sed '/^$/d; s#^#  http://#; s#$#:8787#'
    command -v tailscale >/dev/null && tailscale ip -4 2>/dev/null | sed 's#^#  tailscale http://#; s#$#:8787#' || true
    echo; df -h / | tail -1 | awk '{print "disk: " $3 " used of " $2}'
    free -m | awk '/Mem:/ {print "memory: " $3 " MB used of " $2 " MB"}'
    ;;
  pair)
    hub pair --role "${2:-owner}"
    ;;
  key)
    # sudo nudge key openrouter|gemini|composio
    case "${2:-openrouter}" in
      openrouter) VAR=OPENROUTER_API_KEY; PAT='sk-or-*'; WHAT="OpenRouter key (openrouter.ai/keys)" ;;
      gemini) VAR=GEMINI_API_KEY; PAT='*'; WHAT="Gemini API key (aistudio.google.com, billing on)" ;;
      composio) VAR=COMPOSIO_API_KEY; PAT='*'; WHAT="Composio API key (platform.composio.dev)" ;;
      *) echo "usage: nudge key openrouter|gemini|composio"; exit 1 ;;
    esac
    printf "Paste your %s (input hidden): " "$WHAT"
    stty -echo; read -r KEY; stty echo; echo
    case "$KEY" in $PAT) ;; *) echo "that doesn't look right"; exit 1 ;; esac
    [ ${#KEY} -ge 20 ] || { echo "too short"; exit 1; }
    TMP=$(mktemp); grep -v "^$VAR=" /etc/nudge/hub.env > "$TMP"
    echo "$VAR=$KEY" >> "$TMP"
    install -m 600 -o root -g root "$TMP" /etc/nudge/hub.env; rm -f "$TMP"
    systemctl restart nudge-hub; echo "saved"
    ;;
  dev)
    case "$2" in
      on)
        H=${3:-4}; case "$H" in *[!0-9]*|'') echo "hours must be a number"; exit 1 ;; esac
        [ "$H" -ge 1 ] && [ "$H" -le 24 ] || { echo "1 to 24 hours"; exit 1; }
        CODE=$(od -An -N4 -tu4 /dev/urandom | tr -dc 0-9 | cut -c1-6)
        UNTIL=$(( ($(date +%s) + H * 3600) * 1000 ))
        printf '{"until":%s,"code":"%s"}\n' "$UNTIL" "$CODE" > /etc/nudge/devtools
        chown root:nudge /etc/nudge/devtools; chmod 640 /etc/nudge/devtools
        echo "dev tools on for $H h: open http://<wall>:8787/dev (code for a phone: $CODE)"
        ;;
      off) rm -f /etc/nudge/devtools; echo "dev tools off" ;;
      *) [ -f /etc/nudge/devtools ] && echo "dev tools: on (sudo nudge dev off)" || echo "dev tools: off" ;;
    esac
    ;;
  logs)
    exec journalctl -u "nudge-${2:-hub}" -n 200 -f
    ;;
  restart)
    systemctl restart nudge-hub nudge-gpio nudge-kiosk
    ;;
  update)
    [ -f "$2" ] || { echo "usage: nudge update nudge-pi.tar.gz"; exit 1; }
    D=$(mktemp -d); tar -xzf "$2" -C "$D"
    SRC=$(dirname "$(find "$D" -maxdepth 2 -name install.sh | head -1)")
    bash "$SRC/install.sh" --update; rm -rf "$D"
    ;;
  backup)
    OUT="${2:-$HOME}/nudge-backup-$(date +%Y%m%d-%H%M).tar.gz"
    systemctl stop nudge-hub
    tar -czf "$OUT" -C /var/lib nudge -C /etc nudge
    systemctl start nudge-hub
    chmod 600 "$OUT"; echo "saved $OUT (keep it private — it holds your school sign-in)"
    ;;
  import)
    [ -f "$2" ] || { echo "usage: nudge import nudge-setup.json"; exit 1; }
    curl -sf -X POST -H 'content-type: application/json' --data-binary "@$2" http://127.0.0.1:8788/api/config/import && echo
    ;;
  calendar)
    [ -f "$2" ] || { echo "usage: nudge calendar calendar.pdf"; exit 1; }
    curl -sf -X POST -H 'content-type: application/pdf' --data-binary "@$2" http://127.0.0.1:8788/api/config/calendar && echo
    ;;
  *)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
