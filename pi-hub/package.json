{
  "name": "@nudge/hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Nudge hub — runs on the Raspberry Pi. Stores everything, runs the rules, talks to school.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts --dev",
    "start": "node --no-warnings=ExperimentalWarning dist/hub.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "school:login": "tsx src/school/login-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "@nudge/shared": "*",
    "fastify": "^5.6.0",
    "playwright-core": "^1.55.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "tsx": "^4.20.0",
    "@types/ws": "^8.18.1",
    "ws": "^8.18.3"
  }
}
